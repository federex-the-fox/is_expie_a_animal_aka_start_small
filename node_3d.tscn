[sub_resource type="GDScript" id="GDScript_jka67"]
script/source = "extends CharacterBody2D

@export var plr: CharacterBody2D

const SPEED = 706.0
const JUMP_VELOCITY = -400.0
var dead = false
var finished = false
@onready var hp = get_meta(\"hp\")
@onready var nav = $NavigationAgent2D
var cananim = true
var candmg = false
var lookstop = false

func _physics_process(delta: float) -> void:
	hp = get_meta(\"hp\")
	if hp < 0.1 and !finished:
		dead = true
		if $AudioStreamPlayer.playing == false:
			$AudioStreamPlayer.play()
		if $AnimatedSprite2D:
			$AnimatedSprite2D.play(\"death\")
			await $AnimatedSprite2D.animation_finished
		if $AnimatedSprite2D:
			$AnimatedSprite2D.queue_free()
			$RigidBody2D.process_mode = Node.PROCESS_MODE_ALWAYS
			$RigidBody2D2.process_mode = Node.PROCESS_MODE_ALWAYS
			$RigidBody2D.visible = true
			$RigidBody2D2.visible = true
			
			finished = true
	if !dead:
		var dir = global_position.direction_to(nav.get_next_path_position())
		# Add the gravity.
		nav.target_position = plr.position
		velocity.x = dir.x * SPEED
		if hp < 16:
			if cananim:
				$AnimatedSprite2D.play(\"enraged\")
		else:
			if cananim:
				$AnimatedSprite2D.play(\"walk\")
		# Handle jump.
		if velocity.x != 0:
		# If moving left, flip horizontally to true
		# If moving right, flip horizontally to false
			$AnimatedSprite2D.flip_h = velocity.x < 0
		if !lookstop:
			$RayCast2D.look_at(plr.position)
		move_and_slide()
"

[sub_resource type="GDScript" id="GDScript_i5arm"]
script/source = "extends CharacterBody2D

@export var plr: CharacterBody2D

const SPEED = 706.0
const JUMP_VELOCITY = -400.0
